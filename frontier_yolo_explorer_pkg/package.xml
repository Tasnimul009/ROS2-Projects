<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frontier_yolo_explorer_pkg</name>
  <version>0.0.1</version>
  <description>Frontier exploration (slam_toolbox + explore_lite) with YOLO object detection ball counting.</description>
  <maintainer email="tasz@todo.todo">tasz</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Launch-time dependencies -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>explore_lite</exec_depend>
  <exec_depend>object_detection</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
